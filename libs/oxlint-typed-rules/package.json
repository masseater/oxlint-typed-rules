{
  "name": "@r_masseater/oxlint-typed-rules",
  "version": "0.0.2",
  "description": "Run ESLint rules that need type information as oxlint JS plugins, starting with TanStack Start's React Server Component rules.",
  "keywords": [
    "eslint",
    "oxlint",
    "oxlint-plugin",
    "tanstack-start",
    "typescript"
  ],
  "homepage": "https://github.com/masseater/oxlint-typed-rules#readme",
  "bugs": {
    "url": "https://github.com/masseater/oxlint-typed-rules/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/masseater/oxlint-typed-rules.git",
    "directory": "libs/oxlint-typed-rules"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./tanstack-start": "./src/tanstack-start.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./tanstack-start": {
        "types": "./dist/tanstack-start.d.mts",
        "default": "./dist/tanstack-start.mjs"
      },
      "./package.json": "./package.json"
    },
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "vp pack",
    "test": "vp test run",
    "prepublishOnly": "vp run build",
    "size": "vp run build && size-limit"
  },
  "dependencies": {
    "effect": "catalog:stack",
    "typescript-7": "catalog:typescript-api"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "catalog:",
    "@effect/platform-node": "catalog:",
    "@size-limit/file": "catalog:",
    "@tanstack/eslint-plugin-start": "catalog:",
    "@types/node": "catalog:",
    "@typescript-eslint/utils": "catalog:",
    "publint": "catalog:",
    "size-limit": "catalog:",
    "vite-plus": "catalog:stack"
  },
  "size-limit": [
    {
      "path": "dist/*.mjs",
      "limit": "23825 B"
    }
  ],
  "engines": {
    "node": ">=26"
  }
}
