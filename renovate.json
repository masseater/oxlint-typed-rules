{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "security:minimumReleaseAgeNpm", ":semanticCommits"],
  "automerge": true,
  "ignoreTests": true,
  "platformAutomerge": false,
  "packageRules": [
    {
      "matchPackageNames": [
        "effect",
        "@effect/**",
        "!@effect/tsgo",
        "alchemy",
        "@alchemy.run/**",
        "@distilled.cloud/**"
      ],
      "groupName": "effect and alchemy",
      "automerge": false
    },
    {
      "matchDepNames": ["@tanstack/eslint-plugin-start>globals"],
      "enabled": false
    },
    {
      "matchPackageNames": ["typescript"],
      "allowedVersions": "!/-dev\\./"
    },
    {
      "matchPackageNames": ["@typescript-eslint/**"],
      "prBodyNotes": [
        "typescript-eslint#12803 が入ったリリースなら、#13 のとおり自作の変換層を捨てる。"
      ]
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^skills-lock\\.json$/"],
      "matchStrings": [
        "\"source\": \"(?<depName>[^\"]+)\",\\s*\"ref\": \"(?<currentDigest>[0-9a-f]{40})\",\\s*\"sourceType\": \"github\""
      ],
      "datasourceTemplate": "git-refs",
      "packageNameTemplate": "https://github.com/{{{depName}}}"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^vite\\.config\\.ts$/"],
      "matchStrings": ["uvx (?:--from )?(?<depName>[a-z0-9-]+)@(?<currentValue>[0-9.]+)"],
      "datasourceTemplate": "pypi"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^vite\\.config\\.ts$/"],
      "matchStrings": ["go run (?<depName>[a-z0-9./-]+)@(?<currentValue>v[0-9.]+)"],
      "datasourceTemplate": "go"
    }
  ]
}
